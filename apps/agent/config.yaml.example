# Gridwright agent 配置（复制为 config.yaml 后填）。
# 密钥建议放环境变量，不落本文件。

# 工作区 = 一个文件夹。agent 盯住这里：
#   <workspace>\*.xlsx      被看管的表
#   <workspace>\inbox\      新数据丢这里（csv / xlsx），处理后移入 inbox\done\
#   <workspace>\rules.yaml  规则（长期记忆，记事本可编辑）
#   <workspace>\state.yaml  滚动摘要（LLM 维护）
#   <workspace>\ledger.csv  账目（append-only，可回滚/审计）
workspace: C:\work\台账

# fsnotify 之外的兜底轮询间隔（秒）
poll_seconds: 5
# 发给脑的每表样例行数
sample_rows: 10

llm:
  # OpenAI 兼容 API。base_url 以 /v1 结尾（例如 DeepSeek: https://api.deepseek.com/v1）
  # 也可用环境变量 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL 覆盖。
  base_url: https://api.deepseek.com/v1
  api_key: ""          # 留空则读 env LLM_API_KEY
  model: deepseek-chat
  timeout_seconds: 60

notify:
  # console（M1 打印到日志）| serverchan | pushplus | webhook（M3 实现）
  channel: console
  # serverchan_skey: ""
  # pushplus_token: ""
  # webhook_url: ""
