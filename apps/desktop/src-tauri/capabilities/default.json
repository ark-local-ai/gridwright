{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities — 最小权限沙箱：仅窗口控制 + 拉起随包引擎 exe，不放开无谓的 fs/全局权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "core:window:allow-close",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-minimize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-toggle-maximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-maximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-unmaximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-is-maximized",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-start-dragging",
      "windows": ["main"]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "gridwright",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:allow-open"
  ]
}
